{
  "name": "@abasto/asistente",
  "version": "0.0.1",
  "description": "Asistente: agentes con misión y skills, reportes generativos con Excel, MCP de SQL de solo lectura y proyector CQRS. NestJS.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "evaluar": "vitest run --config ./vitest.config.eval.ts --silent=false --reporter=verbose",
    "arquitectura": "depcruise src --config .dependency-cruiser.cjs",
    "semilla": "node scripts/semilla.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1153.0",
    "@aws-sdk/lib-dynamodb": "^3.1153.0",
    "@google/genai": "2.30.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "amqplib": "^2.2.0",
    "exceljs": "^4.4.0",
    "jose": "^6.2.12",
    "node-sql-parser": "^5.4.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "dependency-cruiser": "^18.7.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
