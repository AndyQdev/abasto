# Subgrafo de Pedidos. Es un contrato: cambiarlo es un PR aparte que aprueba la otra persona.
# El supergrafo lo compone `pnpm supergrafo` junto con Catálogo y Cobros.

extend schema @link(url: "https://specs.apollo.dev/federation/v2.7", import: ["@key", "@shareable"])

type Query {
  "Lo que compró la empresa de la sesión (Mercado)."
  misCompras(estado: EstadoPedido): [Pedido!]!
  "Lo que le compraron a la empresa de la sesión (Panel Mayorista)."
  misVentas(estado: EstadoPedido): [Pedido!]!
  "Un pedido. Null si no existe o si la empresa de la sesión no es ni la tienda ni el mayorista."
  pedido(id: ID!): Pedido
  "CU-16, solo admin (Superadmin): los reclamos en ese estado, o todos; lo más nuevo primero."
  reclamos(estado: EstadoDeReclamo): [Reclamo!]!
  """
  Lo que el mayorista de la sesión tiene que comprar para sus pedidos confirmados que todavía no preparó
  (Abasto vende bajo pedido). Costo y proveedor de cada producto los pone Catálogo.
  """
  listaDeCompras: [LineaDeCompra!]!
  """
  Solo para el equipo de Abasto (rol admin): pedidos y ventas por semana, tiendas activas y las que repiten.
  Con mayoristaId, solo los de ese vendedor (por ejemplo "abasto").
  """
  traccion(mayoristaId: ID, semanas: Int = 8): Traccion!
}

"Los números que muestran que vender en Abasto funciona. Solo cuentan los pedidos confirmados en adelante."
type Traccion {
  pedidos: Int!
  ventas: Dinero!
  ticketPromedio: Dinero!
  "Tiendas que compraron en los últimos 30 días"
  tiendasActivas: Int!
  "Tiendas con dos pedidos o más en el período"
  tiendasQueRepiten: Int!
  semanas: [SemanaDeVentas!]!
  "De la que más compra a la que menos"
  tiendas: [TiendaCompradora!]!
}

type SemanaDeVentas {
  "Lunes de la semana, aaaa-mm-dd"
  desde: String!
  pedidos: Int!
  "Tiendas distintas que compraron esa semana"
  tiendas: Int!
  ventas: Dinero!
}

type TiendaCompradora {
  tienda: Tienda!
  pedidos: Int!
  ventas: Dinero!
}

type Mutation {
  """
  Paso 1 de la saga de compra. La clave la genera la app una sola vez:
  repetir la mutación con la misma clave devuelve el mismo pedido.
  """
  crearPedido(entrada: CrearPedidoEntrada!): Pedido!
  "CU-16: la tienda reporta un problema con su pedido. Hay uno por pedido: repetirlo devuelve el mismo."
  abrirReclamo(entrada: AbrirReclamoEntrada!): Reclamo!
  "CU-16, solo admin: anota cómo se resolvió. No mueve dinero, crédito ni cuentas: la devolución se hace a mano."
  resolverReclamo(entrada: ResolverReclamoEntrada!): Reclamo!
  "Paso 4 de la saga: el mayorista acepta."
  confirmarPedido(id: ID!): Pedido!
  "El mayorista rechaza: se devuelve el cobro y se libera el stock."
  rechazarPedido(id: ID!, motivo: String!): Pedido!
  "Después de confirmar, de a un paso: CONFIRMADO → EN_PREPARACION → DESPACHADO → ENTREGADO."
  avanzarEntrega(id: ID!): Pedido!
}

"Un producto para comprar: la suma de lo que piden todos los pedidos confirmados."
type LineaDeCompra {
  producto: Producto!
  unidades: Int!
  "Lo que pagan las tiendas por esas unidades"
  venta: Dinero!
  "Códigos de los pedidos que lo piden, por ejemplo A-1042"
  pedidos: [String!]!
}

input CrearPedidoEntrada {
  clave: ID!
  mayoristaId: ID!
  metodoPago: MetodoPago!
  lineas: [LineaEntrada!]!
  "A dónde llevarlo. La app la manda siempre; el e-commerce y n8n pueden no tenerla."
  entrega: DireccionEntrada
}

input DireccionEntrada {
  "Calle y número, por ejemplo «Av. Banzer 123»"
  calle: String!
  zona: String
  "Cómo encontrarla: «portón negro, al lado de la farmacia»"
  referencia: String
  "El punto que la tienda marcó en el mapa (los dos o ninguno)"
  latitud: Float
  longitud: Float
}

"A dónde lleva el mayorista el pedido."
type DireccionDeEntrega {
  calle: String!
  zona: String!
  referencia: String!
  latitud: Float
  longitud: Float
  "Calle y zona en una línea"
  texto: String!
}

"El precio no viaja desde la app: lo fija Catálogo al reservar."
input LineaEntrada {
  productoId: ID!
  presentacion: Presentacion!
  cantidad: Int!
}

type Pedido @key(fields: "id") {
  id: ID!
  "Código para las personas, por ejemplo A-1042"
  codigo: String!
  clave: ID!
  tienda: Tienda!
  mayorista: Mayorista!
  lineas: [LineaDePedido!]!
  estado: EstadoPedido!
  metodoPago: MetodoPago!
  "Cero hasta que Catálogo reserva y fija los precios"
  total: Dinero!
  creadoEn: String!
  motivoRechazo: String
  "Null en los pedidos sin dirección (e-commerce, n8n o anteriores al 31/10)"
  entrega: DireccionDeEntrega
  "CU-16: el problema que reportó la tienda. Null si no reportó ninguno"
  reclamo: Reclamo
}

"CU-16: un problema con un pedido, que Abasto resuelve a mano."
type Reclamo {
  id: ID!
  pedido: Pedido!
  motivo: MotivoDeReclamo!
  detalle: String
  estado: EstadoDeReclamo!
  "Lo que Abasto le responde a la tienda"
  respuesta: String
  "Lo que se anotó como devuelto. Null o cero si no se devolvió dinero"
  devuelto: Dinero
  forma: FormaDeDevolucion
  creadoEn: String!
  resueltoEn: String
}

enum MotivoDeReclamo {
  INCOMPLETO
  DANADO
  NO_LLEGO
  COBRO_EQUIVOCADO
  OTRO
}

enum EstadoDeReclamo {
  ABIERTO
  APROBADO
  RECHAZADO
}

enum FormaDeDevolucion {
  EFECTIVO
  TRANSFERENCIA
  QR
  OTRA
}

input AbrirReclamoEntrada {
  pedidoId: ID!
  motivo: MotivoDeReclamo!
  "Obligatorio si el motivo es OTRO"
  detalle: String
}

input ResolverReclamoEntrada {
  reclamoId: ID!
  aprobado: Boolean!
  "Solo al aprobar. Nunca más que el total del pedido"
  devueltoCentavos: Int
  "Obligatoria si se devolvió dinero"
  forma: FormaDeDevolucion
  respuesta: String!
}

type LineaDePedido {
  producto: Producto!
  presentacion: Presentacion!
  cantidad: Int!
  unidades: Int!
  precioUnitario: Dinero
  subtotal: Dinero!
}

enum EstadoPedido {
  PENDIENTE
  POR_CONFIRMAR
  CONFIRMADO
  EN_PREPARACION
  DESPACHADO
  ENTREGADO
  RECHAZADO
  CANCELADO
}

enum MetodoPago {
  QR
  CREDITO
  "Paga al recibir (efectivo o QR): la saga no cobra antes de que el mayorista confirme"
  CONTRA_ENTREGA
}

enum Presentacion {
  UNIDAD
  CUARTA
  DOCENA
  CAJA
  FARDO
}

"Monto en bolivianos. Mismo tipo en los tres subgrafos."
type Dinero @shareable {
  centavos: Int!
  moneda: String!
  texto: String!
}

"Tienda, Mayorista y Producto son de Catálogo; aquí solo se referencian."
type Tienda @key(fields: "id", resolvable: false) {
  id: ID!
}

type Mayorista @key(fields: "id", resolvable: false) {
  id: ID!
}

type Producto @key(fields: "id", resolvable: false) {
  id: ID!
}
