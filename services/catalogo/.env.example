# Catálogo · copia como .env (el contenedor lo hace solo si falta). Solo valores de desarrollo.
APP_NAME=Catalogo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8082
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# MongoDB (réplica rs0). Dentro de Docker: mongodb://mongo:27017/?replicaSet=rs0
DB_CONNECTION=mongodb
MONGODB_URI=mongodb://localhost:27020/?directConnection=true
MONGODB_DATABASE=catalogo

# Catálogo no usa sesiones ni colas en base de datos
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Keycloak: el emisor es el del navegador; las llaves, por la red de Docker si corre adentro
KEYCLOAK_ISSUER=http://localhost:8180/realms/abasto
KEYCLOAK_JWKS_URL=http://localhost:8180/realms/abasto/protocol/openid-connect/certs

LIGHTHOUSE_CACHE_ENABLE=false
ORIGENES_PERMITIDOS=http://localhost:5174

RABBITMQ_HOST=localhost
RABBITMQ_PUERTO=5680
RABBITMQ_USUARIO=abasto
RABBITMQ_CLAVE=abasto
