      "/node_modules/",
      "/android/"
    ],
    "moduleNameMapper": {
      "^@abasto/comercio$": "<rootDir>/../../packages/comercio/src/index.ts",
      "^@abasto/bandeja$": "<rootDir>/../../packages/outbox-offline/src/bandeja.ts"
    }
