{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": [
      "jest"
    ],
    "paths": {
      "@abasto/comercio": [
        "../../packages/comercio/src/index.ts"
      ],
      "@abasto/bandeja": [
        "../../packages/outbox-offline/src/bandeja.ts"
      ],
      "@abasto/marca": [
        "../../packages/ui/marca.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../../packages/comercio/src/**/*.ts",
    "../../packages/outbox-offline/src/bandeja.ts",
    "../../packages/ui/marca.ts"
  ],
  "exclude": [
    "node_modules",
    "../../packages/**/*.spec.ts"
  ]
}
