# Copia este archivo a .env solo si necesitas cambiar algo: sin .env todo funciona con estos valores.
# docker compose lee .env de la raíz. NUNCA subas el .env (ya está en .gitignore).

# --- Puertos de la infraestructura (cámbialos si tu máquina ya usa alguno) ---
PUERTO_POSTGRES=5440
PUERTO_MONGO=27020
PUERTO_DYNAMODB=8800
PUERTO_RABBITMQ=5680
PUERTO_RABBITMQ_UI=15680
PUERTO_KEYCLOAK=8180
PUERTO_ROUTER=4000
PUERTO_JAEGER=16686
PUERTO_N8N=5678

# --- Subgrafos que junta el Router ---
# Por defecto apuntan a los contenedores. Si corres un servicio en tu máquina (por ejemplo
# `pnpm dev:pedidos`), apunta el Router a tu máquina y reinícialo: docker compose restart router
# PEDIDOS_URL=http://host.docker.internal:8081/graphql
# CATALOGO_URL=http://host.docker.internal:8082/graphql
# COBROS_URL=http://host.docker.internal:8083/graphql

# --- Asistente ---
# Sin llave, el Asistente usa el modelo simulado (respuestas fijas, sirve para la demo y los tests).
# Con llave usa Claude. Cada uno pone la suya; no se comparte por el repo.
ANTHROPIC_API_KEY=
# Webhook de n8n que recibe las acciones aprobadas de los agentes (F4)
N8N_WEBHOOK_ACCIONES=

# --- n8n ---
# CONECTA_URL_N8N=http://conecta:8084
