# Copia este archivo a .env solo si necesitas cambiar algo: sin .env todo funciona con estos valores.
# docker compose lee .env de la raíz. NUNCA subas el .env (ya está en .gitignore).

# --- Puertos de la infraestructura (cámbialos si tu máquina ya usa alguno) ---
PUERTO_POSTGRES=5440
PUERTO_MONGO=27020
# Versión de MongoDB (la CI usa 9.0; ver docker-compose.yml)
VERSION_MONGO=8.0
PUERTO_DYNAMODB=8800
PUERTO_RABBITMQ=5680
PUERTO_RABBITMQ_UI=15680
PUERTO_KEYCLOAK=8180
PUERTO_ROUTER=4000
PUERTO_JAEGER=16686
PUERTO_N8N=5678

# --- Subgrafos que junta el Router ---
# Por defecto apuntan a los contenedores. Si corres un servicio en tu máquina (por ejemplo
# `pnpm dev:pedidos`), apunta el Router a tu máquina y reinícialo: docker compose restart router
# PEDIDOS_URL=http://host.docker.internal:8081/graphql
# CATALOGO_URL=http://host.docker.internal:8082/graphql
# COBROS_URL=http://host.docker.internal:8083/graphql

# --- Asistente ---
# Gemini en Vertex AI para el Analista (reportes por texto o voz). Sin proyecto ni llave, el Asistente usa
# el modelo simulado (respuestas fijas, sirve para la demo y los tests). Dos formas de entrar:
# 1) Cuenta de servicio con el rol «Vertex AI User»: su JSON va en .vertex/vertex.json (ignorado por git)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# 2) O una llave de API de Vertex (modo express), sin JSON
VERTEX_API_KEY=
ASISTENTE_MODELO=gemini-3.8-flash
# Webhook de n8n que recibe las acciones aprobadas de los agentes. Vacío usa el de Docker
# (http://n8n:5678/webhook/acciones-agentes); con `pnpm dev:asistente` pon http://localhost:5678/webhook/acciones-agentes
N8N_WEBHOOK_ACCIONES=

# --- n8n ---
# CONECTA_URL_N8N=http://conecta:8084
