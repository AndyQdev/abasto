# Dependencias
node_modules/
vendor/
.venv/
.pnpm-store/

# Builds
dist/
build/
out/
.angular/
.turbo/
.gradle/
services/pedidos/bin/
*.tsbuildinfo
coverage/
dev-dist/
.deptrac.cache

# Expo / React Native (el build de desarrollo se genera con prebuild)
apps/app/android/
apps/app/ios/
apps/app/.expo/
apps/app/web-build/

# Clientes generados (se regeneran al instalar)
services/*/src/infraestructura/persistencia/generado/

# Python
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
ml/datos/fotos/
ml/datos/fotos-referencia/
ml/datos/fotos-web/
ml/datos/platos/
ml/modelos/entrenados/

# Pruebas
playwright-report/
test-results/
e2e/.auth/

# Entorno y secretos: nunca al repo
.env
.env.*
!.env.example
services/catalogo/.env
# Cuenta de servicio de Vertex AI (Gemini)
.vertex/
# Firebase (notificaciones push): la cuenta de servicio y la config de la app no van al repo
.firebase/
apps/app/google-services.json
apps/app/GoogleService-Info.plist
infra/despliegue/*/secretos/
*.pem
*.key

# Laravel
services/catalogo/storage/*.key
services/catalogo/storage/logs/*
services/catalogo/storage/framework/cache/data/*
services/catalogo/storage/framework/sessions/*
services/catalogo/storage/framework/views/*
services/catalogo/bootstrap/cache/*.php
services/catalogo/.phpunit.result.cache

# Sistema y editores
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Claude Code: lo compartido va en .claude/settings.json y .claude/skills
.claude/settings.local.json

# Imágenes crudas de Gemini (las listas van en apps/app/assets/ilustraciones)
.ilustraciones-crudas/

# Despliegue: las webs construidas para la nube (se arman con infra/despliegue/construir-webs.mjs)
infra/despliegue/*/webs/
