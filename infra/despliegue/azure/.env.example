# Copia a .env en la máquina de Azure (nunca lo subas). Las claves: openssl rand -hex 24

# La IP de esta máquina con guiones + .sslip.io
DOMINIO=
# Las otras nubes
DOMINIO_AWS=3-140-59-13.sslip.io
DOMINIO_GCP=34-136-24-10.sslip.io

POSTGRES_CLAVE=
RABBITMQ_CLAVE=
# El mismo valor que en el .env de AWS
KEYCLOAK_COBROS_SECRETO=
# Gemini en Vertex AI para el Analista (reportes por texto o voz). Sin proyecto ni llave, el Asistente usa
# el modelo simulado (respuestas fijas, sirve para la demo y los tests). Dos formas de entrar:
# 1) Cuenta de servicio con el rol «Vertex AI User»: su JSON va en secretos/vertex.json (ignorado por git)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# 2) O una llave de API de Vertex (modo express), sin JSON
VERTEX_API_KEY=
ASISTENTE_MODELO=gemini-3.8-flash
# Llave del usuario IAM abasto-asistente-azure: solo puede usar la tabla asistente de DynamoDB en AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
