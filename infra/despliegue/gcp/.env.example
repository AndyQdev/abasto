# Copia a .env en la máquina de Google Cloud (nunca lo subas). Las claves: openssl rand -hex 24

# La IP fija con guiones + .sslip.io (34.136.24.10 → 34-136-24-10.sslip.io)
DOMINIO=
# Las otras nubes, igual que DOMINIO
DOMINIO_AWS=3-140-59-13.sslip.io
DOMINIO_AZURE=52-230-165-148.sslip.io

# Keycloak: administrador y su base
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_CLAVE=
KEYCLOAK_DB_CLAVE=
# Cuentas de servicio: el mismo valor va en el .env de la nube que usa cada una
# (cuentas → Catálogo, aquí; cobros → Azure; conecta → AWS)
KEYCLOAK_CUENTAS_SECRETO=
KEYCLOAK_COBROS_SECRETO=
KEYCLOAK_CONECTA_SECRETO=

# Catálogo: llave de Laravel ("base64:" + 32 bytes al azar en base64) y RabbitMQ de Azure
CATALOGO_APP_KEY=
RABBITMQ_HOST=52.230.165.148
# La misma RABBITMQ_CLAVE del .env de Azure
RABBITMQ_CLAVE=
