# Entrada HTTPS de AWS. sslip.io convierte la IP en dominio (3-140-59-13.sslip.io → 3.140.59.13),
# así Let's Encrypt da certificados sin comprar un dominio. DOMINIO sale del .env.
conecta.{$DOMINIO} {
	# También el WebSocket de tiempo real (/v1/tiempo-real): Caddy lo pasa solo
	reverse_proxy conecta:8084
}

n8n.{$DOMINIO} {
	reverse_proxy n8n:5678
}
