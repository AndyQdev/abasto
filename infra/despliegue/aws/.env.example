# Copia a .env en la máquina de AWS (nunca lo subas). Las claves: openssl rand -hex 24

# La IP elástica con guiones + .sslip.io (3.140.59.13 → 3-140-59-13.sslip.io)
DOMINIO=
# Las otras nubes, igual que DOMINIO. Keycloak y el Router están en Google
DOMINIO_GCP=34-136-24-10.sslip.io
DOMINIO_AZURE=52-230-165-148.sslip.io

# Cuenta de servicio de Conecta en Keycloak: el mismo valor que en el .env de Google
KEYCLOAK_CONECTA_SECRETO=

# RabbitMQ de Azure: amqp://abasto:<RABBITMQ_CLAVE de Azure>@52.230.165.148:5672
RABBITMQ_URL=

AWS_REGION=us-east-2
