# Copia a .env en la máquina de AWS (nunca lo subas). Las claves: openssl rand -hex 24

# La IP elástica con guiones + .sslip.io (18.231.5.10 → 18-231-5-10.sslip.io)
DOMINIO=

# Keycloak: administrador y su base
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_CLAVE=
KEYCLOAK_DB_CLAVE=
# Cuentas de servicio: el mismo valor va en el .env de la nube que usa cada una
KEYCLOAK_CUENTAS_SECRETO=
KEYCLOAK_COBROS_SECRETO=
KEYCLOAK_CONECTA_SECRETO=

# Las otras dos nubes, igual que DOMINIO. Mientras no estén, deja el ejemplo: el login y las webs andan,
# y lo que pide Pedidos, Cobros o Catálogo responde error hasta que esa nube esté arriba
DOMINIO_AZURE=0-0-0-1.sslip.io
DOMINIO_GCP=0-0-0-2.sslip.io

# RabbitMQ de Azure con TLS (vacío hasta que esté Azure)
RABBITMQ_URL=

AWS_REGION=us-east-2
